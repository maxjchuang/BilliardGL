    "path": "tmp/pdfs/250816-Rules-of-Heyball.pdf",
    "sha256": "2b92dd5088ea630337326e26b7a2a7a4499a9801f2c5da7e5cc40421d5424a24",
    "visually_reviewed_pdf_pages": [8],
    "section_9": {
      "chapter": "II",
      "clause": "9",
      "pdf_page": 8,
      "locator": "Ball in Hand",
      "controlled_paraphrase": "While the cue ball is in hand, the shooter may keep moving it until executing a shot. The general paragraph permits moving it with any cue part, including the tip, but not by forward stroke. Break placement is restricted behind the Head String. The later non-break-foul paragraph permits full-table movement but says only a non-tip cue part may move the ball and a tip touch is a foul."
    },
    "text_uniquely_determines": [
      "a valid placement preview or movement is not itself the shot that ends ball-in-hand",
      "the ball-in-hand entitlement persists through repeated cue-ball movement until a shot is executed",
      "a rejected preview, rejected placement commit, or rejected technical shot request cannot consume the entitlement",
      "break-shot ball in hand remains spatially restricted behind the Head String",
      "ball in hand awarded for a non-break foul permits full-table placement",
      "for the explicit non-break-foul context, touching the cue ball with the cue tip while moving it is a foul"
    ],
    "contextual_tip_reading": {
      "break_or_general_sentence": "tip movement is permitted only when it is not a forward stroke",
      "non_break_foul_specific_sentence": "the later specific sentence prohibits tip contact while moving the in-hand cue ball",
      "specific_non_break_sentence_overrides_general_tip_permission": true,
      "forward_stroke_definition_available": false
    },
    "text_does_not_specify": [
      "the cue-tip kinematic, intent, direction, distance, duration, velocity, or acceleration predicate that constitutes a forward stroke",
      "the numerical contact tolerance and authoritative sample time for cue-part identity",
      "whether a technically accepted miscue or zero-impulse cue contact counts as executing a shot for entitlement consumption",
      "how to classify a cue action whose launch is accepted but physics applies no cue-ball impulse"
    ]
  },
