      "contact_origin": "AUTHORITATIVE_CONTINUOUS_OR_DISCRETE_PHYSICS_CONTACT",
      "contact_completeness_required": true
    },
    "crossing_evidence": {
      "canonical_key": [
        "physics_tick",
        "whole_tick_time_of_impact_seconds",
        "segment_ordinal",
        "observation_id"
      ],
      "origin_required": "AUTHORITATIVE_CONTINUOUS_SURFACE_INTEGRATOR",
      "every_consumed_successful_tick_requires_complete_matching_attestation_until_first_contact": true,
      "missing_malformed_conflicting_or_nonfinite_record_marks_evidence_incomplete": true
    },
    "total_order": {
      "crossing_in_earlier_physics_tick": "BEFORE",
      "crossing_in_later_physics_tick": "AFTER",
      "same_tick_comparator": "crossing.whole_tick_time_of_impact_seconds < first_contact.whole_tick_time_of_impact_seconds",
      "exact_equal_time": "UNORDERED_FAIL_CLOSED",
      "missing_or_incomplete_side": "UNORDERED_FAIL_CLOSED",
      "epsilon_or_quantized_tie_breaker": false,
      "solver_event_or_array_order_may_override_equal_time": false
    },
    "shot_facts_fields": [
      "behindHeadStringFirstContactRestrictionActive",
      "headStringWorldZCm",
      "cueCenterPlaneCrossingEvents",
      "firstCueObjectContactEvidence",
      "cueBallCrossedHeadStringBeforeFirstContact",
      "headStringCrossingEvidenceOrigin",
      "headStringCrossingEvidenceComplete"
    ],
    "direct_or_synthetic_facts_may_claim_complete_crossing": false,
    "legal_object_on_line_or_foot_side_direct_contact_needs_crossing": false,
    "behind_object_direct_contact_without_complete_before_order": "FAIL_CLOSED_WRONG_FIRST_CONTACT"
  },
