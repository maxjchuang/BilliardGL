  "canonical_physics_contract": {
    "observation_request": {
      "type": "PhysicsPlaneObservationRequest",
      "fields": [
        "observation_id",
        "ball_index",
        "axis",
        "plane_coordinate_cm",
        "direction"
      ],
      "wpa_runtime_values": {
        "observation_id": "wpa_ii_08_head_string_cue_center",
        "ball_index": 0,
        "axis": "Z",
        "plane_coordinate_source": "FROZEN_COMMITTED_BEHIND_HEAD_STRING_OFFER",
        "direction": "NEGATIVE_TO_POSITIVE",
        "reference_point": "BALL_CENTER"
      },
      "validation": "all identifiers, indices and numeric values finite/in-range before physics mutation",
      "rule_meaning_in_physics_layer": false
    },
    "surface_motion_analytic_segment": {
      "type": "SurfaceMotionAnalyticSegment",
      "fields": [
        "ball_index",
        "segment_ordinal",
        "motion_state",
        "whole_tick_start_offset_seconds",
        "duration_seconds",
        "start_position_cm",
        "end_position_cm",
        "start_velocity_cm_s",
        "constant_acceleration_cm_s2",
        "analytic_path_complete"
      ],
      "piecewise_split_required_at_sliding_to_rolling_or_stop_transition": true,
      "segments_are_emitted_by_the_same_integrator_that_mutates_ball_state": true,
      "endpoint_linear_interpolation_used_for_crossing": false
    },
    "crossing_candidate": {
      "type": "ContinuousPlaneCrossingCandidate",
      "created_from": "one complete analytic surface-motion segment plus one validated observation request",
      "equation": "axis_position(t)=start_position+start_velocity*t+0.5*constant_acceleration*t^2",
      "linear_fallback_only_when_axis_acceleration_is_exactly_zero": true,
      "valid_root_interval": "0 <= local_t <= segment_duration",
      "required_sign_change": "signed_distance_before < 0 and signed_distance_after > 0",
      "required_derivative_direction": "axis_velocity_at_root > 0",
      "touch_tangent_or_reverse_crossing_is_not_candidate": true,
      "earliest_valid_root_only": true,
      "nonfinite_or_ambiguous_root_invalidates_tick_attestation": true
    },
    "crossing_record": {
      "type": "PhysicsPlaneCrossingRecord",
      "fields": [
        "observation_id",
        "ball_index",
        "axis",
        "plane_coordinate_cm",
        "direction",
        "whole_tick_time_of_impact_seconds",
        "segment_ordinal",
        "signed_distance_before_cm",
        "signed_distance_after_cm",
        "axis_velocity_at_crossing_cm_s",
        "origin",
        "complete"
      ],
      "origin": "AUTHORITATIVE_CONTINUOUS_SURFACE_INTEGRATOR",
      "stable_dedupe_key": [
        "observation_id",
        "ball_index",
        "whole_tick_time_of_impact_seconds",
        "segment_ordinal",
        "direction"
      ],
      "segment_boundary_duplicate_policy": "identical adjacent-segment roots collapse to one record; conflicting roots invalidate completeness"
    },
    "per_tick_attestation": {
      "type": "PhysicsPlaneObservationAttestation",
      "exactly_one_per_valid_request_per_successful_tick": true,
      "fields": [
        "observation_id",
        "ball_index",
        "whole_tick_duration_seconds",
        "covered_segment_count",
        "crossing_record_count",
        "complete"
      ],
      "no_crossing_with_complete_coverage_is_distinguishable_from_missing_telemetry": true,
      "failed_step_publishes_authoritative_attestation": false
    }
  },
  "whole_tick_time_contract": {
    "internal_recursive_parameter": "whole_tick_offset_seconds",
    "top_level_offset_seconds": 0.0,
    "prefix_segment_start_offset": "whole_tick_offset_seconds",
    "prefix_contact_time": "whole_tick_offset_seconds + local_toi_seconds",
    "recursive_tail_offset": "whole_tick_offset_seconds + local_toi_seconds",
    "tail_contact_time_is_rebased_before_telemetry_merge": true,
    "surface_motion_segment_offsets_are_rebased_before_telemetry_merge": true,
    "event_and_segment_ordinals_are_strictly_monotonic_across_recursion": true,
    "all_times_must_be_finite_and_within_closed_whole_tick_interval": true,
    "legacy_segment_relative_contact_toi_may_remain_as_separate_noncanonical_field": true,
    "canonical_order_uses_whole_tick_time_only": true
  },
  "collector_and_shot_facts_contract": {
    "begin_context": {
      "type": "BehindHeadStringFirstContactContext",
