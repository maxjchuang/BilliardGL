  "measurement_extension_contract": {
    "existing_duration_available": true,
    "existing_distance_available": false,
    "minimum_new_interval_field": "relative_tip_ball_path_length_cm",
    "definition": "nonnegative finite line integral of cue-tip motion relative to cue-ball center while the exact canonical interval is active",
    "analytic_interval": "derive from the same authoritative analytic contact trajectory, never from post-hoc endpoint distance",
    "coupled_interval": "sum canonical per-microstep relative displacement while contact is active",
    "authoritative_observer_interval": "sum authenticated ordered motion samples; missing sample or sampling attestation makes measurement incomplete",
    "whole_stroke_duration_seconds": "sum canonical interval durations",
    "whole_stroke_distance_cm": "sum canonical interval relative_tip_ball_path_length_cm",
    "completeness": [
      "d5_a_full_stroke_complete",
      "all_interval_duration_and_path_values_finite",
      "no_dropped_motion_samples",
      "canonical_interval_order",
      "same_shot_identity_and_source_digest"
    ],
    "duration_or_distance_never_compared_to_a_numeric_threshold": true
  },
  "push_classifier_contract": {
    "schema_id": "canonical_push_classification_v1",
    "inputs": [
      "complete canonical cue-tip stroke observation with report-only duration and path length",
      "signed push-review final state consumed by the same shot"
    ],
    "required_identity_match": ["shot_identity", "actor_player_id", "rack_identity", "rules_revision", "rules_state_hash", "push_decision_id", "source_digests"],
    "signed_same_shot_complete_result": "PUSH_FOUL",
    "complete_measurement_without_signed_final": "NO_PUSH_CLASSIFICATION",
    "signed_final_without_complete_measurement": "INCOMPLETE_NO_CLASSIFICATION",
    "numeric_machine_push_branch": false,
    "result_fields": ["schema_id", "shot_identity", "duration_seconds", "distance_cm", "signed_push_decision_id", "source_digest", "selected_policy_sha256", "origin", "complete", "digest"]
  },
  "frozen_cushion_classifier_contract": {
    "schema_id": "canonical_frozen_cushion_classification_v1",
    "inputs": ["complete canonical frozen-cushion shot observation", "complete canonical first legal object contact order", "current signed consumed frozen-cushion declaration"],
    "prerequisite_sample_boundary": "strictly after the canonical first legal object contact of the same shot",
    "prerequisite_satisfied_by": ["any distinct object-ball STRAIGHT_CUSHION contact with velocityImpulseApplied=true", "any complete object-ball pocket capture"],
    "prerequisite_excludes": ["pre-first-contact events", "pocket jaws", "position correction without velocity impulse", "cue-ball pocket", "incomplete or wrong-shot events"],
    "when_prerequisite_satisfied": "NO_EXTRA_SECTION_15_2_OBLIGATION",
    "when_prerequisite_unmet_legal_alternatives": [
      "declared object departs then recontacts exact named straight cushion with velocity impulse",
      "another object ball contacts a straight cushion with velocity impulse after first legal object contact",
      "an object ball has a complete pocket capture after first legal object contact"
    ],
    "when_prerequisite_unmet_without_alternative": "FROZEN_CUSHION_FOUL",
    "jaw_counts": false
  },
  "rules_consumption_contract": {
    "classifications_occur_after_d5_a_and_d5_b_finish": true,
    "shotfacts_may_carry_only_complete_immutable_results": true,
    "new_foul_reasons": ["Push", "FrozenCushionObligation"],
    "both_use_existing_general_foul_ball_in_hand": true,
    "adjudicator_may_not_recompute_measurements_or_event_order": true,
    "signed_frozen_cue_object_never_suppresses_push_foul": true,
    "classification_is_bound_to_current_completed_shot": true
  },
  "atomicity_and_idempotency": {
    "stage_before_shotfacts_finish": true,
    "publish_with_same_completed_shot_transaction": true,
    "failed_incomplete_or_gapped_telemetry_rolls_back": true,
    "identity_revision_state_hash_decision_or_digest_conflict_zero_delta": true,
    "exact_retry_same_digest_zero_delta": true,
    "reset_rerack_turn_or_next_shot_invalidates_unpublished_result": true,
    "adjudication_failure_restores_runtime_match_facts_authority_and_revision": true
  },
