  "semantic_alias_risks": [
    {
      "alias_group": "impact_hit_alias",
      "severity": "HIGH",
      "risk": "Cue strike, ball-ball contact, rail contact, and pocket-jaw contact resolve to byte-identical content. Without supported pitch variation, the sound cannot independently identify material/contact semantics and can weaken shot-event readability during dense collisions.",
      "affected_buses": ["effects"]
    },
    {
      "alias_group": "notification_gameover_alias",
      "severity": "HIGH",
      "risk": "Routine UI feedback, foul notification, and match finish resolve to the same 15.873-second waveform. Shared content collapses urgency and outcome hierarchy and can cause an ordinary interaction to sound equivalent to a terminal match event.",
      "affected_buses": ["ui"]
    },
    {
      "alias_group": "background_loop_alias",
      "severity": "HIGH",
      "risk": "Music and venue ambience use the same decoded waveform. Separate bus gains or mute controls do not make the content semantically distinct; the two user controls may appear functionally redundant.",
      "affected_buses": ["music", "ambience"]
    },
    {
      "alias_group": "cross_asset_technical_consistency",
      "severity": "MEDIUM",
      "risk": "The four repository files mix 11.025, 22.05, and 44.1 kHz PCM16 sources. Runtime resampling and unequal source bandwidth can make cues inconsistent even before artistic balancing.",
      "affected_buses": ["music", "ambience", "effects", "ui"]
    }
  ],
